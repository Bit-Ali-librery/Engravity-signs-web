# Normalize line endings: store LF in repo, checkout per-OS native.
# Eliminates "LF will be replaced by CRLF" warnings on Windows.
* text=auto eol=lf

# Always-binary file types (never touch line endings)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.zip  binary
*.tar  binary
*.gz   binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.pdf  binary
*.mp4  binary
*.mov  binary

# Force LF on shell + config files (LF-only environments break otherwise)
*.sh   text eol=lf
*.bash text eol=lf

# Windows batch + PowerShell stay CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
