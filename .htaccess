# ═══════════════════════════════════════════════════════════════════════
# .htaccess — Engravity Signs (Hostinger / Apache)
# ═══════════════════════════════════════════════════════════════════════

# ─── Charset por defecto ─────────────────────────────────────────────
AddDefaultCharset UTF-8

# ─── Habilitar mod_rewrite ───────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ── Forzar HTTPS ──
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ── Forzar www (engravitysigns.com → www.engravitysigns.com) ──
  RewriteCond %{HTTP_HOST} ^engravitysigns\.com$ [NC]
  RewriteRule ^(.*)$ https://www.engravitysigns.com/$1 [L,R=301]

  # ── Quitar /index.html de las URLs ──
  # /pricing/index.html → /pricing/
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.*)/index\.html\ HTTP/
  RewriteRule ^(.*)/index\.html$ /$1/ [L,R=301]

  # /index.html en raíz → /
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
  RewriteRule ^index\.html$ / [L,R=301]

  # ── Permitir URLs sin .html (sirve el archivo .html sin redirect) ──
  # Si alguien escribe /blog/madera-y-metal sirve /blog/madera-y-metal.html
  # internamente, sin cambiar la URL en el navegador.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # NOTA: Los enlaces internos del sitio mantienen el .html y funcionan tal cual.
  # Si en el futuro quieres redirigir todas las .html a clean URLs, descomenta:
  # RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.+)\.html\ HTTP/
  # RewriteRule ^(.+)\.html$ /$1 [L,R=301]
</IfModule>

# ─── Página 404 personalizada (cuando exista) ────────────────────────
ErrorDocument 404 /404.html

# ─── Compresión Gzip ─────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/atom+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# ─── Cache del navegador (Expires) ───────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                              "access plus 1 month"

  # HTML — corto para que actualizaciones se vean rápido
  ExpiresByType text/html                     "access plus 0 seconds"

  # CSS y JS — 1 mes (los versionamos con ?v=8 para invalidar cuando haga falta)
  ExpiresByType text/css                      "access plus 1 month"
  ExpiresByType text/javascript               "access plus 1 month"
  ExpiresByType application/javascript        "access plus 1 month"

  # Imágenes — 6 meses
  ExpiresByType image/png                     "access plus 6 months"
  ExpiresByType image/jpg                     "access plus 6 months"
  ExpiresByType image/jpeg                    "access plus 6 months"
  ExpiresByType image/gif                     "access plus 6 months"
  ExpiresByType image/webp                    "access plus 6 months"
  ExpiresByType image/svg+xml                 "access plus 6 months"
  ExpiresByType image/x-icon                  "access plus 6 months"

  # Fuentes — 1 año
  ExpiresByType font/woff                     "access plus 1 year"
  ExpiresByType font/woff2                    "access plus 1 year"
  ExpiresByType application/font-woff         "access plus 1 year"
  ExpiresByType application/font-woff2        "access plus 1 year"

  # XML / texto técnico
  ExpiresByType application/xml               "access plus 1 hour"
  ExpiresByType text/xml                      "access plus 1 hour"
  ExpiresByType text/plain                    "access plus 1 hour"
</IfModule>

# ─── Cache-Control headers ───────────────────────────────────────────
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|jpeg|gif|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=15768000"
  </FilesMatch>
  <FilesMatch "\.(woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  # ── Headers de seguridad básicos ──
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # ── HSTS — forzar HTTPS por 2 años (después podemos agregar preload) ──
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains" env=HTTPS

  # ── Content Security Policy — defensa principal contra XSS ──
  # Allows: self + Google Fonts (CSS+font), GSAP CDN, Lenis CDN, Firebase SDK,
  #         Firebase API endpoints (REST + WebSocket), Cloudflare trace (IP geolocation)
  # 'unsafe-inline' is required because the site uses inline onclick handlers and
  # <style> attributes; migrate to addEventListener + classes to remove eventually.
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://unpkg.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.cloudflare.com https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.firebaseapp.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://*.firebasestorage.app; frame-ancestors 'self'; form-action 'self'; base-uri 'self'; object-src 'none';"

  # ── Cross-Origin policies (modern hardening) ──
  Header set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header set Cross-Origin-Resource-Policy "same-origin"
</IfModule>

# ─── Bloquear acceso a archivos sensibles ────────────────────────────
# Includes: dotfiles (.git, .gitignore, .gitattributes), .htaccess itself,
# config (json, yml, lock, rules), scripts (bat, ps1, sh), docs (md, txt),
# build artifacts (zip, tar, gz), deploy logs.
<FilesMatch "(^\.|\.htaccess|\.json$|\.lock$|\.bat$|\.ps1$|\.sh$|\.md$|\.markdown$|\.rules$|\.yml$|\.yaml$|\.zip$|\.tar$|\.gz$|\.log$|\.sql$|\.env$|\.bak$|package\.json|vite\.config\.js)">
  Require all denied
</FilesMatch>

# Block whole sensitive directories (defense in depth)
RedirectMatch 404 /\.git
RedirectMatch 404 /\.github
RedirectMatch 404 /node_modules
RedirectMatch 404 /imagen
RedirectMatch 404 /ima

# ─── MIME types correctos ────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/font-woff .woff
  AddType application/font-woff2 .woff2
</IfModule>

# ─── Index por defecto ───────────────────────────────────────────────
DirectoryIndex index.html

# ─── Quitar trailing slash duplicado ─────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_URI} ^(.*)//(.*)$
  RewriteRule . %1/%2 [R=301,L]
</IfModule>
