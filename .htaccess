# ═══════════════════════════════════════════════════════════════════════
# .htaccess — Engravity Signs (Hostinger / Apache)
# ═══════════════════════════════════════════════════════════════════════

# ─── Charset por defecto ─────────────────────────────────────────────
AddDefaultCharset UTF-8

# ─── Habilitar mod_rewrite ───────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ── Forzar HTTPS ──
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ── Forzar www (engravitysigns.com → www.engravitysigns.com) ──
  RewriteCond %{HTTP_HOST} ^engravitysigns\.com$ [NC]
  RewriteRule ^(.*)$ https://www.engravitysigns.com/$1 [L,R=301]

  # ── Quitar /index.html de las URLs ──
  # /pricing/index.html → /pricing/
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.*)/index\.html\ HTTP/
  RewriteRule ^(.*)/index\.html$ /$1/ [L,R=301]

  # /index.html en raíz → /
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
  RewriteRule ^index\.html$ / [L,R=301]

  # ── Permitir URLs sin .html (sirve el archivo .html sin redirect) ──
  # Si alguien escribe /blog/madera-y-metal sirve /blog/madera-y-metal.html
  # internamente, sin cambiar la URL en el navegador.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # NOTA: Los enlaces internos del sitio mantienen el .html y funcionan tal cual.
  # Si en el futuro quieres redirigir todas las .html a clean URLs, descomenta:
  # RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.+)\.html\ HTTP/
  # RewriteRule ^(.+)\.html$ /$1 [L,R=301]
</IfModule>

# ─── Página 404 personalizada (cuando exista) ────────────────────────
ErrorDocument 404 /404.html

# ─── Compresión Gzip ─────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/atom+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# ─── Cache del navegador (Expires) ───────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                              "access plus 1 month"

  # HTML — corto para que actualizaciones se vean rápido
  ExpiresByType text/html                     "access plus 0 seconds"

  # CSS y JS — 1 mes (los versionamos con ?v=8 para invalidar cuando haga falta)
  ExpiresByType text/css                      "access plus 1 month"
  ExpiresByType text/javascript               "access plus 1 month"
  ExpiresByType application/javascript        "access plus 1 month"

  # Imágenes — 6 meses
  ExpiresByType image/png                     "access plus 6 months"
  ExpiresByType image/jpg                     "access plus 6 months"
  ExpiresByType image/jpeg                    "access plus 6 months"
  ExpiresByType image/gif                     "access plus 6 months"
  ExpiresByType image/webp                    "access plus 6 months"
  ExpiresByType image/svg+xml                 "access plus 6 months"
  ExpiresByType image/x-icon                  "access plus 6 months"

  # Fuentes — 1 año
  ExpiresByType font/woff                     "access plus 1 year"
  ExpiresByType font/woff2                    "access plus 1 year"
  ExpiresByType application/font-woff         "access plus 1 year"
  ExpiresByType application/font-woff2        "access plus 1 year"

  # XML / texto técnico
  ExpiresByType application/xml               "access plus 1 hour"
  ExpiresByType text/xml                      "access plus 1 hour"
  ExpiresByType text/plain                    "access plus 1 hour"
</IfModule>

# ─── Cache-Control headers ───────────────────────────────────────────
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|jpeg|gif|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=15768000"
  </FilesMatch>
  <FilesMatch "\.(woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  # ── Headers de seguridad básicos ──
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ─── Bloquear acceso a archivos sensibles ────────────────────────────
<FilesMatch "(^\.|\.htaccess|\.json$|\.lock$|\.bat$|\.ps1$|package\.json|vite\.config\.js)">
  Require all denied
</FilesMatch>

# ─── MIME types correctos ────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/font-woff .woff
  AddType application/font-woff2 .woff2
</IfModule>

# ─── Index por defecto ───────────────────────────────────────────────
DirectoryIndex index.html

# ─── Quitar trailing slash duplicado ─────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_URI} ^(.*)//(.*)$
  RewriteRule . %1/%2 [R=301,L]
</IfModule>
