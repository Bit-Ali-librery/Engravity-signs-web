rules_version = '2';

// ════════════════════════════════════════════════════════════════════
// Engravity — Firestore Security Rules
// ════════════════════════════════════════════════════════════════════
// Estas reglas son lo que protege tus datos. Sin ellas, cualquier persona
// podría leer y modificar cualquier documento.
//
// Para aplicarlas:
//   1. Ve a console.firebase.google.com → tu proyecto → Firestore Database
//   2. Pestaña "Rules"
//   3. Borra todo el contenido del editor
//   4. Pega exactamente lo de abajo
//   5. Click "Publish"
// ════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── USERS ─────────────────────────────────────────────────
    // Cada usuario solo puede leer/escribir su propio documento de perfil.
    // El UID del documento debe coincidir con el UID del usuario autenticado.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // En signup permitimos crear el doc por primera vez
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'user'  // no se puede auto-asignar admin
        && request.resource.data.plan in ['free', 'student'];  // arranca en plan gratuito

      // Updates: el usuario puede cambiar sus preferencias y nombre,
      // pero NO el rol ni el plan (eso solo desde backend / Cloud Functions).
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.plan == resource.data.plan
        && request.resource.data.uid == resource.data.uid;

      // Borrar perfil: el propio usuario puede eliminar su cuenta
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ─── SUBSCRIPTIONS ─────────────────────────────────────────
    // Solo el dueño puede leer su suscripción.
    // Solo se escribe desde backend (Cloud Functions con webhooks de Stripe).
    match /subscriptions/{subscriptionId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow write: if false; // bloqueado desde el cliente
    }

    // ─── PAYMENTS ──────────────────────────────────────────────
    // Igual que subscriptions: solo lectura para el dueño.
    match /payments/{paymentId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ─── PROJECTS (a futuro: cuando guardemos diseños del usuario) ──
    // Por ahora bloqueado. Cuando active esta colección, descomenta:
    // match /projects/{projectId} {
    //   allow read, write: if request.auth != null
    //     && resource.data.userId == request.auth.uid;
    //   allow create: if request.auth != null
    //     && request.resource.data.userId == request.auth.uid;
    // }

    // ─── DEFAULT: bloquear todo lo demás ───────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
